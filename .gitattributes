# Normalize text files to LF in Git and in Windows/Linux working trees.
# Git detects binary files automatically and leaves their contents unchanged.
* text=auto eol=lf

# Keep Windows command scripts in CRLF format in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf

# Store Project 3 model weights with Git LFS.
projects/project3/assets/models/*.bin filter=lfs diff=lfs merge=lfs -text

# Preserve raw PPM pixel data without text conversion.
projects/project3/assets/dataset/images/*.ppm binary
